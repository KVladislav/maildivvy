# Managed by Ansible (roles/programs). Install step 13.
# The fetch runner: one mpop per external mailbox (docs/architecture.md § The path of a
# message, Collect). It runs as the mail owner, because it hands every retrieved message
# to the delivery filter, which files it in the domain's archive.
[Unit]
Description=Maildivvy: collect mail from every external mailbox
Documentation=file://{{ maildivvy_opt }}/lib/maildivvy/fetch/runner.py
After=network-online.target postgresql.service dovecot.service
Wants=network-online.target
# A pause holds this unit, whatever starts it: while a record of one is there a
# start is skipped, not failed, so a timer that fires inside a pause, after a reboot too,
# starts nothing; the program never runs on a schema or a fetch state it may not pair with.
ConditionPathExists=!{{ maildivvy_upgrade_pause_record }}
ConditionPathExists=!{{ maildivvy_backup_pause_record }}

[Service]
Type=oneshot
User=vmail
Group=vmail
ExecStart={{ maildivvy_opt }}/bin/maildivvy-fetch
# A run that overruns the timer's period is not killed here, and the timer never starts
# a second one beside it: it is not armed while this unit is active, and counts its next
# slot from this run's start (systemd 259, no DeferReactivation=), so every slot that
# passed collapses into one run that starts as soon as this one ends. Mailboxes are
# collected one after another, so one slow provider delays every mailbox after it. When
# a run by hand overlaps this one, whichever reaches a mailbox second finds its try-lock
# held and skips it. mpop itself is bounded by the runner's own wall-clock
# timeout, which is what this allows for.
TimeoutStartSec={{ maildivvy_fetch_run_timeout }}

# Install step 13's hardening, one set on every program of ours.
ProtectSystem=strict
# ⛔ NOT THE FETCH STATE ALONE, AND BELIEVING THAT COST 21 SCHEDULED RUNS THAT
# DELIVERED NOTHING. mpop's delivery command is our filter, the filter runs dovecot-lda,
# and a child inherits this namespace: with the store left out the LDA fails
# `Read-only file system` on every message while mpop, and then the unit, report success.
# Every one of these is written on an ordinary run; each exists before the
# unit first starts, made by step 2 and by the layout above.
ReadWritePaths={{ maildivvy_var }}/fetch {{ maildivvy_store }} {{ maildivvy_index }}
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=true
UMask=0077
# It binds nothing and opens no privileged port: it keeps no capability at all, in
# either set, because one set alone is dropped with no message naming it.
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
