# Managed by Ansible (roles/health). Install step 17.
# Health: every subsystem checked, the JSON report kept current for the operator's
# monitoring. It runs as its own user, with a read-only database
# role and the groups clamav, maildivvy-rspamd and systemd-journal; what that user cannot
# read, the two helpers read and hand back over their sockets (health/helper.py).
[Unit]
Description=Maildivvy: check every subsystem and write the health report
Documentation=file://{{ maildivvy_health_opt }}/lib/maildivvy/health/run.py
After=network-online.target postgresql.service dovecot.service postfix.service
Wants=network-online.target

[Service]
Type=oneshot
User={{ maildivvy_health_user }}
Group={{ maildivvy_health_user }}
# With a textfile directory set, every run also writes maildivvy.prom there.
ExecStart={{ maildivvy_health_program }} --quiet{{ (' --textfile-dir ' ~ maildivvy_health_textfile_dir) if maildivvy_health_textfile_dir else '' }}
# ⛔ The exit code is the report's worst state (1 WARN, 2 FAIL, 3 UNKNOWN), not the unit's
# failure: the unit fails only when the program cannot run. A run that cannot run writes
# no report, and the report going stale is what a collector reads as UNKNOWN.
SuccessExitStatus=1 2 3
TimeoutStartSec={{ maildivvy_health_run_timeout }}

# Install step 13's hardening, one set on every program of ours.
ProtectSystem=strict
# The report, and the upstream answers it keeps between asks; the textfile directory, when
# one is set. Nothing else.
ReadWritePaths={{ maildivvy_health_dir }}{{ (' ' ~ maildivvy_health_textfile_dir) if maildivvy_health_textfile_dir else '' }}
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=true
UMask=0077
CapabilityBoundingSet=
# AF_NETLINK: `ss` reads the listeners over netlink (sock_diag), and without it falls back
# to /proc with a warning on every run
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
