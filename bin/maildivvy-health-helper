#!/usr/bin/python3
"""The readings maildivvy-health cannot take as its own user. See health/helper.py.

systemd starts this once per connection on its socket: `store` as vmail, `system` as root.
"""

import sys
from pathlib import Path

sys.dont_write_bytecode = True  # /opt/maildivvy is the deployed tree exactly

# /opt/maildivvy/bin -> /opt/maildivvy/lib; bin/ -> src/ in a checkout
for lib in ("lib", "src"):
    candidate = Path(__file__).resolve().parents[1] / lib
    if (candidate / "maildivvy").is_dir():
        sys.path.insert(0, str(candidate))
        break

from maildivvy.health.helper import main  # noqa: E402

sys.exit(main())
