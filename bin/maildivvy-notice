#!/usr/bin/python3
"""File a notice Postfix wrote to a sender in that sender's domain archive. See
deliver/notice.py.

Postfix's pipe(8) runs this as the mail owner for every message with the null sender;
nothing else runs it.
"""

import sys
from pathlib import Path

sys.dont_write_bytecode = True  # /opt/maildivvy is the deployed tree exactly

# /opt/maildivvy/bin -> /opt/maildivvy/lib; bin/ -> src/ in a checkout
for lib in ("lib", "src"):
    candidate = Path(__file__).resolve().parents[1] / lib
    if (candidate / "maildivvy").is_dir():
        sys.path.insert(0, str(candidate))
        break

from maildivvy.deliver.notice import main  # noqa: E402

sys.exit(main())
