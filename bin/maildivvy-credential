#!/usr/bin/python3
"""Print one external mailbox's provider credential on stdout, and nothing else.

mpop runs this through `passwordeval`; nothing else runs it. See fetch/credential.py.
"""

import sys
from pathlib import Path

sys.dont_write_bytecode = True  # /opt/maildivvy is the deployed tree exactly

# /opt/maildivvy/bin -> /opt/maildivvy/lib; bin/ -> src/ in a checkout
for lib in ("lib", "src"):
    candidate = Path(__file__).resolve().parents[1] / lib
    if (candidate / "maildivvy").is_dir():
        sys.path.insert(0, str(candidate))
        break

from maildivvy.fetch.credential import main  # noqa: E402

sys.exit(main())
