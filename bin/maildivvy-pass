#!/usr/bin/python3
"""Record the archive's new mail and fan it out. See fanout/pass_.py.

A timer runs this every minute as the mail owner, once for every domain.
"""

import sys
from pathlib import Path

sys.dont_write_bytecode = True  # /opt/maildivvy is the deployed tree exactly

# /opt/maildivvy/bin -> /opt/maildivvy/lib; bin/ -> src/ in a checkout
for lib in ("lib", "src"):
    candidate = Path(__file__).resolve().parents[1] / lib
    if (candidate / "maildivvy").is_dir():
        sys.path.insert(0, str(candidate))
        break

from maildivvy.fanout.pass_ import main  # noqa: E402

sys.exit(main())
