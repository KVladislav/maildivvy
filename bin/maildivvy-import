#!/usr/bin/python3
"""Import a directory of message files into a domain. See importer/run.py.

The operator runs this as the mail owner; nothing on the machine starts it.
"""

import sys
from pathlib import Path

sys.dont_write_bytecode = True  # /opt/maildivvy is the deployed tree exactly

# /opt/maildivvy/bin -> /opt/maildivvy/lib; bin/ -> src/ in a checkout
for lib in ("lib", "src"):
    candidate = Path(__file__).resolve().parents[1] / lib
    if (candidate / "maildivvy").is_dir():
        sys.path.insert(0, str(candidate))
        break

from maildivvy.importer.run import main  # noqa: E402

sys.exit(main())
