# Managed by Ansible (roles/health). Install step 17.
# The store helper's socket: maildivvy-health connects, systemd starts one helper as the
# mail owner for the connection, and it answers with its readings (health/helper.py).
[Unit]
Description=Maildivvy: the health helper that reads the store and the fetch state

[Socket]
ListenStream={{ maildivvy_health_store_socket }}
SocketUser=root
SocketGroup={{ maildivvy_health_user }}
SocketMode=0660
Accept=yes
MaxConnections=4

[Install]
WantedBy=sockets.target
